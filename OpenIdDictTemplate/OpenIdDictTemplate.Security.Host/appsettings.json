{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/security.db",
    "SqlServer": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=OpenIdDictTemplateSecurity;Integrated Security=True;Encrypt=False",
    "Postgres": "Host=localhost;Port=5432;Database=openiddict_template_security;Username=postgres;Password=postgres"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrationsOnStartup": true
  },
  "Security": {
    "Issuer": "https://localhost:7017/",
    "DefaultRedirectUrl": "/",
    "AccessTokenLifetime": "04:00:00",
    "CorsOrigins": [],
    "DisableTransportSecurityRequirement": false,
    "Certificates": {
      "UseDevelopmentCertificates": false,
      "Encryption": { "Path": "", "Password": "" },
      "Signing": { "Path": "", "Password": "" }
    }
  },
  "Email": {
    "Type": "Smtp",
    "FromAddress": "no-reply@example.com",
    "FromName": "OpenIdDictTemplate",
    "ProductName": "OpenIdDictTemplate",
    "Smtp": { "Server": "", "Port": 587, "Username": "", "Password": "" }
  }
}
