@model ResetPasswordWithTokenViewModel
@{
    ViewData["Title"] = "Create a password";
}

<div class="d-flex align-items-center justify-content-center">
    <div class="card login-card">
        <div class="card-header">
            <h5 class="card-title">Create a password</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Account" asp-action="ResetPasswordWithToken" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />
                <partial name="_ValidationSummary" />

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input type="password" class="form-control" placeholder="Password" asp-for="Password" autocomplete="new-password" autofocus>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input type="password" class="form-control" placeholder="Confirm password" asp-for="ConfirmPassword" autocomplete="new-password">
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="text-right">
                    <button class="btn btn-primary" type="submit">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>
