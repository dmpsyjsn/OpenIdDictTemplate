@{
    ViewData["Title"] = "Check your email";
}

<div class="d-flex align-items-center justify-content-center">
    <div class="card login-card">
        <div class="card-header">
            <h5 class="card-title">Check your email</h5>
        </div>
        <div class="card-body">
            <p>If an account exists for that email address, we have sent instructions for continuing.</p>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Back to login</a>
        </div>
    </div>
</div>
