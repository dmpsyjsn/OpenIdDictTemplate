@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="d-flex align-items-center justify-content-center">
    <div class="card login-card">
        <div class="card-header">
            <h5 class="card-title">Forgot Password</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <p>Enter your email address and instructions to reset your password will be sent to you.</p>
                <partial name="_ValidationSummary" />
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input class="form-control" placeholder="Please enter your email address" asp-for="Email" autofocus>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="text-right">
                    <button class="btn btn-primary" type="submit">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>
